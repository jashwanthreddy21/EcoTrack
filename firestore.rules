rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global helper primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles: users can read their own profile, or admins/supervisors can read
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || resource.data.email == request.auth.token.email);
      allow delete: if false;
    }

    // Households: citizens manage their own households, staff can read
    match /households/{householdId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Pickup requests: citizens create, collectors update status, supervisors/admins schedule
    match /pickup_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Collection schedules: read by authenticated users, written by supervisors/admins
    match /collection_schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Notifications: users read and update their own notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
